# Gravity Well Gateway configuration example
# Copy to ~/.config/gravity-well/gateway.env (chmod 0600).
# If gateway.env does not exist on first startup, the gateway automatically
# creates it with 0600 permissions and a fresh random 256-bit bearer token.

# GRAVITY_WELL_AGY_BIN=/home/jason/.local/bin/agy
# GRAVITY_WELL_DEFAULT_CWD=/home/jason
# GRAVITY_WELL_ALLOWED_ROOTS=/home/jason
# GRAVITY_WELL_HOST=0.0.0.0
# GRAVITY_WELL_PORT=9340
